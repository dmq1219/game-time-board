# Family Hub — Supabase 连接（复制为 .env.local 并填入真实值）
# 控制台 → 你的项目 → Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 可选：公开访问 PIN 门禁。设置后进 /family 需先输入此 PIN（存 localStorage，
# kiosk 不必每次重输）。留空则不拦截。注意：这是应用层门禁，anon key 仍在
# 公开 bundle 里，敏感数据请同时开启 Supabase RLS。
VITE_FAMILY_PIN=
